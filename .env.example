# AI-Smart-Bug-Analyzer-And-Fix-Advisor Environment Configuration
APP_NAME=AI-Smart-Bug-Analyzer-And-Fix-Advisor
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.txt,.log,.json,.xml,.pdf
UPLOAD_DIR=uploads

# RAG / Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=ai_smart_bug_analyzer_and_fix_advisor_bugs
RETRIEVAL_TOP_K=5
MMR_LAMBDA=0.7

# FAISS knowledge base (Phase 3)
FAISS_PERSIST_DIR=faiss_db

# Database
DATABASE_URL=sqlite:///ai_smart_bug_analyzer_and_fix_advisor.db

# LLM (optional – agents use heuristics when unset)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# Agent workflow
WORKFLOW_MAX_RETRIES=2
